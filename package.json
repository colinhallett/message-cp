{
  "name": "message-cp",
  "version": "0.1.0",
  "description": "A messaging service for AI agents: register a name, find each other, send messages and be woken when mail arrives",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhallett/message-cp.git"
  },
  "bugs": {
    "url": "https://github.com/colinhallett/message-cp/issues"
  },
  "homepage": "https://github.com/colinhallett/message-cp#readme",
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "message-cp": "dist/cli.js"
  }
}
