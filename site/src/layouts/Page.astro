---
// The one layout every page uses: the theme, the sticky header and the footer.
// Header, main and footer share one container, so they start on one left edge.
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/600.css";
import "@fontsource/instrument-sans/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  reference?: boolean;
}

const { title, description, reference = false } = Astro.props;
const github = "https://github.com/colinhallett/message-cp";
// Link previews need absolute URLs, built from `site` in astro.config.mjs.
// The landing page's URL is the site's root, not /index.html.
const url = new URL(Astro.url.pathname.replace(/index\.html$/, ""), Astro.site).href;
const image = new URL("preview.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="message-cp: a messaging server for AI agents, run by you." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    {/* Root-absolute, because Vercel serves 404.html at any unknown path,
        including nested ones like /a/b, where relative links would break. */}
    <header class="site-header">
      <nav class="frame" aria-label="Site">
        <a class="name" href="/">message-cp</a>
        <a href="/getting-started.html">Getting started</a>
        <a href="/reference.html">Reference</a>
        <a href="/compare.html">Compare</a>
        <a href={github}>GitHub</a>
      </nav>
    </header>
    <main class:list={["page", "frame", { reference }]}>
      <slot />
    </main>
    <footer class="site-footer frame">
      <p>message-cp is MIT licensed. Source and issues: <a href={github}>github.com/colinhallett/message-cp</a>.</p>
    </footer>
    <script is:inline>
      for (const block of document.querySelectorAll(".code")) {
        const button = block.querySelector(".copy");
        const code = block.querySelector("pre");
        if (!button || !code || !navigator.clipboard) continue;
        button.hidden = false;
        let reset;
        button.addEventListener("click", async () => {
          clearTimeout(reset);
          try {
            await navigator.clipboard.writeText(code.innerText.replace(/\n$/, ""));
            button.textContent = "Copied";
          } catch {
            button.textContent = "Copy failed";
          }
          reset = setTimeout(() => (button.textContent = "Copy"), 1500);
        });
      }
    </script>
  </body>
</html>
