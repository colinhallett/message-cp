---
// A highlighted code block. The colours come from CSS variables in
// global.css, so one highlighted block serves both themes. The copy button is
// hidden until the inline script in the layout shows it, so with JavaScript
// off the block is a plain highlighted block.
import { highlighter } from "./highlighter";

interface Props {
  code: string;
  lang?: "sh" | "json" | "js" | "caddyfile" | "text";
}

const { code, lang = "text" } = Astro.props;

// Shiki has no Caddyfile grammar; nginx's is the closest and colours its
// directives and braces.
const grammar = { sh: "shellscript", json: "json", js: "javascript", caddyfile: "nginx", text: "text" }[lang];

const html = (await highlighter).codeToHtml(code, { lang: grammar, theme: "site" });
---

<div class="code">
  <Fragment set:html={html} />
  <button type="button" class="copy" hidden>Copy</button>
</div>
