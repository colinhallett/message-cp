---
// One block with a panel per client. Every panel is rendered visible, each
// under a heading with its client's name, so with JavaScript off the block
// reads top to bottom. The inline script turns it into WAI-ARIA tabs: it
// shows the tab list, hides the headings and every panel but the selected
// one, and moves between tabs with the arrow keys, Home and End.
import CodeBlock from "./CodeBlock.astro";

interface Tab {
  label: string;
  /** One or two sentences of trusted HTML, from the page itself. */
  text: string;
  code: string;
  lang: "sh" | "json" | "js" | "caddyfile" | "text";
}

interface Props {
  id: string;
  tabs: Tab[];
}

const { id, tabs } = Astro.props;
---

<div class="tabs" data-tabs>
  <div class="tab-list" role="tablist" aria-label="Clients" hidden>
    {tabs.map((tab, i) => (
      <button type="button" role="tab" id={`${id}-tab-${i}`} aria-controls={`${id}-panel-${i}`} aria-selected="false" tabindex="-1">
        {tab.label}
      </button>
    ))}
  </div>
  {tabs.map((tab, i) => (
    <section class="tab-panel" id={`${id}-panel-${i}`}>
      <h4>{tab.label}</h4>
      <p set:html={tab.text} />
      <CodeBlock lang={tab.lang} code={tab.code} />
    </section>
  ))}
</div>

<script is:inline>
  for (const block of document.querySelectorAll("[data-tabs]:not([data-ready])")) {
    block.dataset.ready = "";
    const list = block.querySelector("[role=tablist]");
    const tabs = [...list.querySelectorAll("[role=tab]")];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls")));
    const select = (index, focus) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      const panel = panels[i];
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", tab.id);
      panel.tabIndex = 0;
      panel.querySelector("h4").hidden = true;
      tab.addEventListener("click", () => select(i, false));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[event.key];
        if (next === undefined) return;
        event.preventDefault();
        select(next, true);
      });
    });
    list.hidden = false;
    select(0, false);
  }
</script>
