{
  "mcpServers": {
    "message-cp": {
      "type": "http",
      "url": "${MESSAGE_CP_URL}/mcp",
      "headers": {
        "Authorization": "Bearer ${MESSAGE_CP_HTTP_TOKEN}",
        "X-Message-CP-Agent": "planner",
        "X-Message-CP-Agent-Key": "${MESSAGE_CP_PLANNER_KEY}"
      }
    }
  }
}
