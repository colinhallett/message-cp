{
  "name": "colin/memory-cp",
  "mode": "vendored",
  "dependencies": {
    "tessl-labs/factory-setup": {
      "version": "0.3.0"
    }
  },
  "actions": {
    "implement": {
      "skill": "colin/ticket-to-pr-implement",
      "environment": "factory-memory-cp-implement",
      "agent": "claude",
      "model": "claude-opus-5-5",
      "snapshotFamily": "dev"
    },
    "shepherd-session": {
      "skill": "file:tessl-factory#pr-shepherd-session",
      "environment": "factory-memory-cp-shepherd",
      "agent": "claude",
      "model": "claude-opus-5-5",
      "snapshotFamily": "dev"
    },
    "chat-test": {
      "skill": "file:tessl-factory#chat-test",
      "environment": "memory-cp-chat-test",
      "agent": "claude",
      "model": "claude-opus-5-5"
    }
  },
  "triggers": {
    "issue-delegated": {
      "on": [
        "linear:Issue.create",
        "linear:Issue.update"
      ],
      "when": {
        "event.data.delegateId": "255a43a8-0c1d-421d-8625-8e1b92634d86",
        "event.data.state.type": "unstarted"
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:{{ event.data.id }}",
            "limit": 1
          }
        ]
      },
      "action": "implement"
    },
    "pr-labelled": {
      "on": [
        "github:pull_request.labeled"
      ],
      "when": {
        "event.label.name": "tessl",
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.state": "open"
      },
      "concurrency": {
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd-session"
    },
    "pr-review": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.state": "open",
        "event.sender.login": {
          "not": {
            "equals": "tessl-helper[bot]"
          }
        }
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd-session"
    },
    "pr-checks-failed": {
      "on": [
        "github:check_run.completed"
      ],
      "when": {
        "event.check_run.pull_requests.0.number": {
          "exists": true
        },
        "event.check_run.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_run.conclusion": {
          "in": [
            "failure",
            "timed_out",
            "startup_failure",
            "action_required"
          ]
        }
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.check_run.pull_requests.0.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd-session"
    }
  },
  "schedules": {
    "agent-retro-test": {
      "action": {
        "skill": "builtin:agent-retro",
        "environment": "agent-retro-memory-cp",
        "agent": "claude",
        "model": "claude-opus-5-5",
        "inputs": {
          "orgId": "73b1c8ba-aa78-4e68-b831-50165291b3ba",
          "projectId": "01a13487-e1a4-7180-8d3b-7ac5a4ef9b1e",
          "windowDays": "7"
        }
      },
      "cron": "0 3 29 2 *",
      "timezone": "UTC",
      "description": "Agent Retro test loop: run by hand with tessl schedule trigger; the cron only fires on 29 February"
    },
    "chat-test": {
      "action": "chat-test",
      "cron": "0 3 29 2 *",
      "timezone": "UTC",
      "description": "Chat test over memory-cp; run by hand with tessl schedule trigger"
    }
  }
}
